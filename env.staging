#--------------------------------------------------------------------
# TEMPLATE .env UNTUK SERVER STAGING
#
# Cara pakai di server:
#   cp env.staging .env
# lalu isi nilai yang masih berupa <placeholder>.
# File .env tidak ikut ke git.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
# development = tampilkan detail error (dipakai saat staging masih diuji)
# production  = sembunyikan detail error
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://<domain-staging-website>/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
# Harus database yang SAMA dengan yang dipakai CMS staging.
#--------------------------------------------------------------------

database.default.hostname = <host-db-staging>
database.default.database = <nama-db-staging>
database.default.username = <user-db-staging>
database.default.password = '<password-db-staging>'
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# PELINDO MARINE - APP SPECIFIC
#--------------------------------------------------------------------

# Domain CMS staging. Semua media (banner, foto pejabat, dokumen regulasi,
# annual report, welcome screen) dimuat dari <domain>/uploads/<path>.
pelindo.mediaBaseUrl = https://<domain-staging-cms>

# Folder arsip file form PPID / Marine Care (default: public/upload).
# pelindo.uploadPath = /mnt/gcs/upload

# Penerima email form kontak / marine care (pakai alamat uji di staging)
pelindo.contactEmail = 'hello@digitalinformatika.com'

# Penerima notifikasi form E-PPID (pisahkan dengan koma)
pelindo.ppidRecipients = 'hello@digitalinformatika.com'

# Endpoint & API key pengirim email PPID
pelindo.ppidMailApi = '<endpoint-api-email-ppid>'
pelindo.ppidMailApiKey = '<api-key-email-ppid>'

# Chatbot Gemini (kosongkan bila chatbot tidak diuji di staging)
pelindo.geminiApiKey = ''
pelindo.geminiModel = 'gemini-flash-latest'
pelindo.chatAdminEmail = 'hello@digitalinformatika.com'
